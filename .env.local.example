# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-only, never exposed to the browser. Used for admin
# operations (inviting users, suspending accounts, bypassing RLS in cron jobs).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret required in the Authorization header of Render Cron Job calls
# to internal /api/cron/* route handlers.
CRON_SECRET=change-me

# Base URL of this deployment, used to build invite/reset links in emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (Checkout + webhook) — online payment on the public quote page.
# Bank transfer remains available even if these are left unset.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# SMTP — shared transactional sender (quote sent, quote accepted/rejected,
# job offered/accepted/rejected, supplier invoice submitted, staff/supplier
# invites, and anything else with no logged-in sender, e.g. payment
# confirmations). Wording for each template is editable from Email Centre ->
# Templates once signed in. Leave unset and these emails are silently
# skipped rather than breaking the underlying action.
#
# A staff member who has connected their own mailbox (Settings -> Users ->
# Mailbox, or Email Centre -> My Signature) sends from that mailbox instead
# of this shared one — SMTP_* below only covers everyone else / anything
# fully automated.
#
# Using SendGrid: host is always smtp.sendgrid.net, port 587, and the
# username is the literal string "apikey" — not your SendGrid account name.
# SMTP_PASS is the API key itself. SMTP_FROM must be an address on a domain
# you've completed Domain Authentication for in SendGrid (Settings -> Sender
# Authentication), otherwise SendGrid rejects the send outright.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM="Global Transport CRM <bookings@globalbusrental.com>"

# 32 raw bytes, base64-encoded — encrypts/decrypts the IMAP/SMTP passwords
# staff mailboxes are connected with (Settings -> Users -> Mailbox, synced by
# the email-sync cron job into the Email Centre). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing/rotating this key makes every already-stored mailbox password
# undecryptable — mailboxes would need to be reconnected.
EMAIL_CREDENTIALS_KEY=change-me-32-bytes-base64

# OpenAI — reads pasted itinerary text or an uploaded quote file (PDF/Word/
# image) on the Complex Booking form and extracts a structured multi-leg
# lead. Leave unset and Complex Booking form submissions fail at the
# "Extract with AI" step (rest of the CRM is unaffected).
OPENAI_API_KEY=sk-your-openai-api-key

# Google Maps JS API key — needs the "Places API" and "Maps JavaScript API"
# enabled on the project. Public/browser-exposed by design (NEXT_PUBLIC_).
# Powers the pickup/destination address autocomplete on the new enquiry form
# and the dashboard's live satellite map. Leave unset and both features
# degrade gracefully (plain text address input, static placeholder panel).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
